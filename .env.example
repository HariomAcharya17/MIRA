# Copy to .env and fill in. Never commit .env.
# Server-only keys: read by /api/* functions, never exposed to the browser.
# Do NOT prefix these with VITE_.

# Groq — https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# NVIDIA build — https://build.nvidia.com (free trial)
NVIDIA_API_KEY=
# Tavily web search — https://app.tavily.com (1,000 free credits/month)
TAVILY_API_KEY=

# Optional: shared rate limits + search cache across serverless instances
# (Upstash Redis free tier). Without these, limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
# RATE_LIMIT_PER_MIN=12
# RATE_LIMIT_PER_DAY=200
# ALLOWED_ORIGINS=https://example.com

# Client (public by design; protect data with Supabase Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
